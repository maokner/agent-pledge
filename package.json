{
  "name": "agent-pledge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-pledge/server dev",
    "start": "pnpm --filter @agent-pledge/server start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @agent-pledge/server db:generate",
    "db:migrate": "pnpm --filter @agent-pledge/server db:migrate",
    "db:seed": "pnpm --filter @agent-pledge/server db:seed",
    "db:reset": "pnpm --filter @agent-pledge/server db:reset",
    "demo:reset": "pnpm db:reset && pnpm --dir apps/server exec tsx ../../scripts/demo-reset.ts",
    "smoke": "pnpm --dir apps/server exec tsx ../../scripts/smoke.ts",
    "deploy:secrets": "pnpm --dir apps/server exec tsx ../../scripts/gen-secrets.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "ledger:demo": "pnpm --filter @agent-pledge/ledger demo",
    "format:check": "prettier --check .",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
