# Copy to apps/voice-agent/.env and fill in. Never commit .env.

# --- Provisioning (pnpm provision) ---
# ElevenLabs API key with Agents access. Not needed for --dry-run.
ELEVENLABS_API_KEY=
# Set after the first run so later runs update the same agent (the script prints it).
ELEVENLABS_AGENT_ID=
# Optional: the phone number to route to the agent (Phone Numbers page in the ElevenLabs dashboard).
ELEVENLABS_PHONE_NUMBER_ID=
# Public https base URL of the server (or of a tunnel to the mock server). No trailing slash needed.
PUBLIC_BASE_URL=
# Shared secret for the x-agent-pledge-secret header. The server and the mock server check it. At least 16 characters.
# Make one with: openssl rand -hex 24
VOICE_TOOL_SECRET=

# Optional overrides (defaults in src/config.ts).
# ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
# ELEVENLABS_LLM=gemini-2.5-flash
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
# ELEVENLABS_AGENT_NAME=Agent Pledge
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Mock server (pnpm mock-server) ---
# MOCK_PORT=8787
# MOCK_BOARD_URL=http://localhost:8787/board
# MOCK_FAIL=none
