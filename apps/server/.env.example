# Copy to apps/server/.env (or the repo root .env). Every value has a dev default; production must set the secrets.

NODE_ENV=development
LOG_LEVEL=info
PORT=3001
HOST=0.0.0.0

# Board + claim page (apps/web). Claim links are <PUBLIC_BASE_URL>/c/<CODE>.
PUBLIC_BASE_URL=http://localhost:3000
# This server's public URL. NFT URIs (<PUBLIC_API_URL>/tasks/<id>.json) and media URLs use it.
PUBLIC_API_URL=http://localhost:3001

# postgres://user:pass@host:5432/db  -> node-postgres (production)
# pglite://.data/pglite              -> embedded Postgres on disk, relative to apps/server (local dev)
# memory://                          -> in-memory PGlite (tests)
DATABASE_URL=pglite://.data/pglite

# fake (in-memory ledger, default) or xrpl (packages/ledger on XRPL testnet)
LEDGER_MODE=fake

# Secrets (generate with: openssl rand -hex 32)
VOICE_SHARED_SECRET=change-me-voice-secret
AGENT_TOKEN=change-me-agent-token
COOKIE_SECRET=change-me-cookie-secret-at-least-32-chars
SEED_ENCRYPTION_KEY=change-me-seed-encryption-key

# Comma-separated origins allowed by CORS (credentials allowed)
CORS_ORIGINS=http://localhost:3000

# The local agent's XRPL address (required for xrpl mode). The agent's seed is NEVER set here.
AGENT_ADDRESS=
PLEDGE_AMOUNT=1.00
# Treasury -> new requester wallet. Empty = exactly the task price.
REQUESTER_FUNDING_AMOUNT=

# Fake ledger
FAKE_LEDGER_LATENCY_MS=300
FAKE_AGENT_BALANCE=100.00

# Deadline checker (failure flow, #24)
SCHEDULER_INTERVAL_MS=2000
MAX_UPLOAD_BYTES=8388608

# XRPL (LEDGER_MODE=xrpl)
XRPL_NETWORK_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org
VAULT_SEED=
TREASURY_SEED=
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY=524C555344000000000000000000000000000000
