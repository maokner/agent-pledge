{
  "name": "@agent-pledge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset"
  },
  "dependencies": {
    "@agent-pledge/ledger": "workspace:*",
    "@agent-pledge/shared": "workspace:*",
    "@electric-sql/pglite": "^0.3.11",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/http-proxy": "^11.6.4",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino-pretty": "^13.1.2",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.5",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
