# Copy to .env.local and adjust.

# 1 = serve fixture data and a simulated live event stream (no server needed).
NEXT_PUBLIC_FIXTURES=1

# Server base URL. Empty = same origin (server and board on one host).
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket base URL. Defaults to NEXT_PUBLIC_API_URL with http(s) -> ws(s).
# NEXT_PUBLIC_WS_URL=ws://localhost:8080

# XRPL explorer for transaction, account and NFT links. Defaults to testnet.
# NEXT_PUBLIC_XRPL_EXPLORER_URL=https://testnet.xrpl.org
