# Copy to .env.local and adjust.

# 1 = serve fixture data and a simulated live event stream (no server needed).
NEXT_PUBLIC_FIXTURES=1

# The server (origin/backend-all, apps/server) base URL. Defaults to http://localhost:3001,
# the server's PORT, when fixture mode is off. Empty = same origin.
# The server must list this web app's origin in its CORS_ORIGINS (for example
# CORS_ORIGINS=http://localhost:3000), and its PUBLIC_BASE_URL must point here
# (claim links are <PUBLIC_BASE_URL>/c/<CODE>, board links <PUBLIC_BASE_URL>/?task=<id>).
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebSocket base URL. Defaults to NEXT_PUBLIC_API_URL with http(s) -> ws(s).
# NEXT_PUBLIC_WS_URL=ws://localhost:3001

# XRPL explorer for links the server sends no URL for. Defaults to testnet.
# NEXT_PUBLIC_XRPL_EXPLORER_URL=https://testnet.xrpl.org

# --- Backup form (#38). Server-only: no NEXT_PUBLIC_ prefix, so these never reach the browser. ---
# Passcode the operator types into the backup form. The form is off until this is set
# (in fixture mode it is optional).
# BACKUP_FORM_PASSCODE=
# Server base URL as this Next.js server reaches it. Defaults to NEXT_PUBLIC_API_URL if absolute.
# AGENT_PLEDGE_SERVER_URL=http://localhost:3001
# The voice agent's shared secret (the server's VOICE_SHARED_SECRET), sent as x-agent-pledge-secret
# to POST /tools/create_task.
# AGENT_PLEDGE_VOICE_SECRET=
# caller_phone for tasks made with the form when it is left empty. Optional: without it the task has no phone.
# BACKUP_FORM_CALLER_PHONE=
