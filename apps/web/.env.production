# Committed on purpose. The hosted web app (Vercel) bakes this in at build time.
# It is the public URL of the server (the cloudflared tunnel from pnpm demo:local).
# pnpm demo:local --web-url <site> rewrites it; commit and push so Vercel redeploys.
# A NEXT_PUBLIC_API_URL set in the Vercel dashboard overrides this file.
NEXT_PUBLIC_API_URL=https://regulated-improvement-dose-closest.trycloudflare.com
