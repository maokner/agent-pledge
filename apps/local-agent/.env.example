# Local agent (apps/local-agent). Copy to apps/local-agent/.env. This file stays on the laptop.

# --- Server ---
# HTTP base URL of apps/server (PUBLIC_API_URL).
SERVER_URL=http://localhost:3001
# WebSocket URL. Defaults to SERVER_URL with ws(s):// and /ws/agent.
SERVER_WS_URL=ws://localhost:3001/ws/agent
# Must match AGENT_TOKEN on the server.
AGENT_TOKEN=change-me-agent-token

# --- Ledger ---
# fake: the server performs the agent's ledger steps (no XRPL). xrpl: sign on this laptop with AGENT_SEED.
LEDGER_MODE=fake
# The agent's own XRPL seed. NEVER put this on the server. Only used when LEDGER_MODE=xrpl.
AGENT_SEED=
# The vault address (xrpl mode). Same vault as the server's VAULT_SEED.
VAULT_ADDRESS=
XRPL_NETWORK_URL=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER_URL=https://testnet.xrpl.org
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY=524C555344000000000000000000000000000000

# --- Model ---
# llm: Claude Agent SDK with the five tools. scripted: same steps without a model (fallback, tests).
# Defaults to llm when ANTHROPIC_API_KEY is set, else scripted.
AGENT_MODE=
ANTHROPIC_API_KEY=
# A fast model so the task is claimed and the sub-task made within seconds.
AGENT_MODEL=claude-haiku-5-5

# --- Yik Yak (#29) ---
# render: headless preview card, NOT a real post (safe default).
# playwright: real post in a visible Chromium window with our logged-in profile.
# computer-use: not implemented yet (see #28).
YIKYAK_DRIVER=render
# At most one real post per this many seconds (PRD 8: 10 minutes).
YIKYAK_MIN_INTERVAL_SECONDS=600
# Playwright driver settings. Fill in after #28 confirms the site and its selectors.
YIKYAK_URL=https://yikyak.com
# Optional button that opens the composer (leave empty if the text box is already on the page).
YIKYAK_COMPOSE_SELECTOR=
YIKYAK_TEXT_SELECTOR=textarea
YIKYAK_SUBMIT_SELECTOR=button[type="submit"]
# Persistent browser profile with our Yik Yak login. Default: <AGENT_STATE_DIR>/chrome-profile
YIKYAK_PROFILE_DIR=
# Set to "chrome" to drive the installed Google Chrome instead of Playwright's Chromium.
YIKYAK_BROWSER_CHANNEL=
YIKYAK_POST_WAIT_MS=3000

# --- Local state ---
# Rate-limit state, screenshots, and the default browser profile. Default: apps/local-agent/.data
AGENT_STATE_DIR=
